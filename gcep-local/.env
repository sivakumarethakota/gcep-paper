# GCEP local deployment — environment overrides.
# Copy this to .env (Docker Compose auto-loads it) or export in your shell.

# Resource profile: tiny | small | full
COMPOSE_PROFILES=tiny

# Where to bind host ports. Default 127.0.0.1 keeps the testbed off the LAN.
# Set to 0.0.0.0 only if you understand the implications.
BIND_HOST=127.0.0.1

# Fabric versions — pin these explicitly so reruns are reproducible.
FABRIC_VERSION=2.5.10
FABRIC_CA_VERSION=1.5.13
COUCHDB_VERSION=3.3.3

# Project name (also Docker network prefix).
COMPOSE_PROJECT_NAME=gcep

# Per-container memory caps. Drop these on a constrained host.
PEER_MEM=2g
ORDERER_MEM=1g
COMMITTEE_MEM=512m
IPFS_MEM=1g
COUCHDB_MEM=512m
